{
  "name": "medlink-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The multilingual, fully static MedLink corporate website",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/site.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src astro.config.mjs",
    "format:check": "prettier --check src astro.config.mjs"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
