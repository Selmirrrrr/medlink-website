---
import Icon from "./Icon.astro";
import type { Content } from "../types";
interface Props {
  t: Content;
  type?: string;
  compact?: boolean;
}
const { type = "dashboard", t, compact = false } = Astro.props;
const m = t.mock;
const waveHeights = [
  18, 28, 41, 25, 53, 66, 43, 30, 62, 76, 45, 61, 34, 51, 68, 40, 47, 29, 33,
  57, 42, 24, 30, 38, 23, 16, 27, 19,
];
---

<div class:list={["product-visual", `visual-${type}`, { compact }]}>
  {type === "dashboard" && (
    <div class="dashboard-scene">
      <div class="dashboard-window">
        <div class="window-top">
          <span class="window-logo">
            MedLink<span>®</span>
          </span>
          <span class="window-dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span class="avatar">ML</span>
        </div>
        <div class="dashboard-layout">
          <div class="dashboard-sidebar" aria-hidden="true">
            <span class="selected">
              <Icon name="grid" size={18} />
            </span>
            <Icon name="calendar" size={18} />
            <Icon name="users" size={18} />
            <Icon name="heart" size={18} />
            <Icon name="chart" size={18} />
            <span class="sidebar-bottom">
              <Icon name="shield" size={18} />
            </span>
          </div>
          <div class="dashboard-body">
            <div class="dashboard-title">
              <div>
                <span>{m.date}</span>
                <h3>{m.today}</h3>
              </div>
              <span class="live-dot">{m.live}</span>
            </div>
            <div class="dashboard-metrics">
              {[
                [m.visits, "128", "calendar"],
                [m.team, "24", "users"],
                [m.complete, "98%", "heart"],
              ].map(([label, value, icon]) => (
                <div>
                  <span>{label}</span>
                  <strong>
                    {value}
                    <Icon name={icon} size={19} />
                  </strong>
                  <span class="tiny-line"></span>
                </div>
              ))}
            </div>
            <div class="dashboard-rounds">
              <div class="mini-section-title">
                <strong>{m.schedule}</strong>
                <span>08:00 — 12:00</span>
              </div>
              <div class="schedule-grid">
                <div class="time-column">
                  <span>08:00</span>
                  <span>09:00</span>
                  <span>10:00</span>
                  <span>11:00</span>
                </div>
                {["AL", "SM", "JB"].map((initials, i) => (
                  <div class="schedule-person">
                    <div class="person-label">
                      <span class={`avatar avatar-${i}`}>{initials}</span>
                      <span>{["Alice L.", "Sarah M.", "Julien B."][i]}</span>
                    </div>
                    <div class={`appointment appointment-${i}`}>
                      <strong>{["Jeanne R.", "Paul M.", "Anne B."][i]}</strong>
                      <small>{m.visit}</small>
                      <span>
                        08:{i === 1 ? "30" : "00"} – 09:{i === 1 ? "15" : "00"}
                      </span>
                    </div>
                    <div class={`appointment appointment-${(i + 1) % 3}`}>
                      <strong>{["André C.", "Marie D.", "Luc F."][i]}</strong>
                      <small>{m.care}</small>
                      <span>10:00 – 10:45</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="dashboard-bottom">
              <span>
                <i class="green-dot"></i>
                {m.synced}
              </span>
              <span>
                <Icon name="shield" size={13} />
                {m.hosted}
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="floating-note">
        <span class="note-icon">
          <Icon name="check" size={20} />
        </span>
        <span>
          <strong>{m.validated}</strong>
          <small>{m.record}</small>
        </span>
        <span class="note-time">09:41</span>
      </div>
      <div class="floating-care">
        <span class="care-orbit">
          <Icon name="heart" size={22} />
        </span>
        <div>
          <strong>{m.rounds}</strong>
          <span>{m.roundsSub}</span>
        </div>
      </div>
      <div class="scene-caption">{t.common.example}</div>
    </div>
  )}
  {type === "scribe" && (
    <div class="scribe-demo">
      <div class="voice-note">
        <span class="mini-label">
          <Icon name="wave" size={16} />
          {m.voice}
        </span>
        <div class="waveform" aria-hidden="true">
          {waveHeights.map((height, i) => (
            <i style={`--height:${height}px;--delay:${i * 40}ms`}></i>
          ))}
        </div>
        <blockquote>{m.quote}</blockquote>
        <span class="audio-time">
          00:42 <span>•••</span>
        </span>
      </div>
      <div class="scribe-transfer" aria-hidden="true">
        <Icon />
      </div>
      <div class="structured-note">
        <div class="mini-label">
          <Icon name="spark" size={18} />
          {m.output}
        </div>
        <dl>
          {m.reportLabels.map((label, i) => (
            <div>
              <dt>{label}</dt>
              <dd>{m.reportValues[i]}</dd>
            </div>
          ))}
        </dl>
        <div class="review-note">
          <Icon name="shield" size={16} />
          {m.review}
        </div>
      </div>
    </div>
  )}
  {type === "care" && (
    <div class="clinical-card">
      <div class="clinical-person">
        <span class="patient-avatar">JR</span>
        <div>
          <strong>{m.patient}</strong>
          <span>{m.patientInfo}</span>
        </div>
        <span class="status-pill">{m.status}</span>
      </div>
      <p class="mini-label">{m.recordTitle}</p>
      <dl>
        {m.recordRows.map((label, i) => (
          <div>
            <dt>{label}</dt>
            <dd>{m.recordValues[i]}</dd>
          </div>
        ))}
      </dl>
      <div class="mini-label assessment-label">{m.assessments}</div>
      <div class="tag-list">
        {m.assessmentTags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <div class="clinical-foot">
        <Icon name="users" size={18} />
        {m.synced}
        <Icon name="check" size={18} />
      </div>
    </div>
  )}
  {type === "planning" && (
    <div class="planning-demo">
      <div class="mini-section-title">
        <span>
          <Icon name="calendar" size={18} />
          {m.schedule}
        </span>
        <span class="live-dot">{m.live}</span>
      </div>
      <div class="planning-columns">
        {m.staff.map((person, i) => (
          <div>
            <h3>{person}</h3>
            {i === 0 ? (
              <div class="absence">
                <Icon name="users" />
                <strong>{m.absent}</strong>
                <small>{m.reassigned}</small>
              </div>
            ) : (
              [
                "07:30 – 08:15",
                "08:30 – 09:15",
                "09:30 – 10:15",
                "11:00 – 11:45",
              ].map((time, j) => (
                <div
                  class:list={[
                    "planning-visit",
                    { changed: (i + j) % 3 === 0 },
                  ]}
                >
                  <strong>
                    {["M. Favre", "M. Bonvin", "M. Meyer", "J. Aubert"][j]}
                  </strong>
                  <span>{time}</span>
                  {(i + j) % 3 === 0 && <small>{m.added}</small>}
                </div>
              ))
            )}
          </div>
        ))}
      </div>
      <div class="planning-alert">
        <Icon name="check" size={18} />
        {m.reassigned}
        <span>07:15</span>
      </div>
    </div>
  )}
  {type === "team" && (
    <div class="team-demo">
      <div class="mini-section-title">
        <strong>Team Planner</strong>
        <span class="live-dot">{m.live}</span>
      </div>
      <div class="chart-legend">
        <span>
          <i class="legend-dot demand-dot"></i>
          {m.demand}
        </span>
        <span>
          <i class="legend-dot capacity-dot"></i>
          {m.capacity}
        </span>
      </div>
      <div class="resource-chart">
        <svg viewBox="0 0 600 220" aria-hidden="true">
          <path
            d="M0 200H600M0 140H600M0 80H600M0 20H600"
            stroke="#dce8e8"
            stroke-width="1"
          />
          <path
            d="M0 175C90 165 140 160 205 130S335 30 380 48 470 138 600 140L600 120C480 148 380 130 290 134S110 145 0 150Z"
            fill="#1b9b8b"
            opacity=".17"
          />
          <path
            d="M0 175C90 165 140 160 205 130S335 30 380 48 470 138 600 140"
            fill="none"
            stroke="#1b9b8b"
            stroke-width="4"
            stroke-dasharray="8 7"
          />
          <path
            d="M0 150C110 145 200 130 290 134S480 148 600 120"
            fill="none"
            stroke="#153e54"
            stroke-width="3"
          />
          <path d="M360 45V137" stroke="#127e74" stroke-width="2" />
          <circle cx="360" cy="45" r="6" fill="#1b9b8b" />
          <circle cx="360" cy="137" r="6" fill="#153e54" />
        </svg>
        <span class="gap-label">{m.gap}</span>
      </div>
      <div class="chart-days">
        {m.days.map((day) => (
          <span>{day}</span>
        ))}
      </div>
      <div class="team-people">
        {["AL", "SM", "JB", "NC"].map((initials, i) => (
          <span class={`avatar avatar-${i % 3}`}>{initials}</span>
        ))}
        <span>{m.capacity}</span>
        <strong>24</strong>
      </div>
    </div>
  )}
  {type === "cockpit" && (
    <div class="cockpit-demo">
      <div class="kpi-grid">
        {m.metrics.map((label, i) => (
          <div>
            <span>{label}</span>
            <strong>{["94 %", "71 %", "93 %", "6,4 %"][i]}</strong>
            <small class:list={[{ warning: i === 3 }]}>
              {i === 3 ? m.watch : `↗ +${[2, 3, 1][i]} pts`}
            </small>
            <svg viewBox="0 0 160 32" aria-hidden="true">
              <path
                d={`M0 28 30 24 65 ${i === 3 ? 19 : 15} 95 18 125 10 160 4`}
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              />
            </svg>
          </div>
        ))}
      </div>
      <div class="bar-chart">
        <p class="mini-label">{m.billed}</p>
        <div class="bars">
          {m.months.map((month, i) => (
            <div>
              <div class="bar-pair">
                <i style={`height:${[76, 85, 79, 90, 82, 95][i]}%`}></i>
                <i style={`height:${[70, 79, 73, 85, 77, 91][i]}%`}></i>
              </div>
              <span>{month}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
  {type === "factoring" && (
    <div class="factoring-demo">
      <div class="advance-card">
        <span class="mini-label">Factoring by MLS</span>
        <div>
          <strong>
            100<span>%</span>
          </strong>
          <p>
            {m.advance}
            <br />
            <b>{m.within}</b>
          </p>
          <span class="advance-check">
            <Icon name="check" size={28} />
          </span>
        </div>
      </div>
      <div class="invoice-table-wrap">
        <table class="invoice-table">
          <thead>
            <tr>
              {m.invoices.map((label) => (
                <th>{label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {m.debtors.map((debtor, i) => (
              <tr>
                <td>F-2026-041{i + 2}</td>
                <td>{debtor}</td>
                <td>CHF {["4 820", "640", "2 310"][i]}.–</td>
                <td>
                  <span class={`payment-state state-${i}`}>
                    {m.paymentStates[i]}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="factoring-flow">
        {m.flow.map((step, i) => (
          <span>
            <i>{i === 3 ? "✓" : `0${i + 1}`}</i>
            {step}
          </span>
        ))}
      </div>
    </div>
  )}
</div>
