---
import Layout from "../layouts/Layout.astro";
import { content } from "../content/index.mjs";
import { languages, url, languageNames } from "../routes.mjs";
---

<Layout lang="fr" page="404">
  <section class="section not-found">
    <div class="container">
      <span class="eyebrow">404</span>
      {languages.map((lang) => (
        <div lang={lang}>
          <h1>{content[lang].notFound.title}</h1>
          <p>{content[lang].notFound.text}</p>
          <a class="text-link" href={url(lang)}>
            {content[lang].common.back} · {languageNames[lang]} →
          </a>
        </div>
      ))}
    </div>
  </section>
</Layout>
